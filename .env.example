# Supabase — infraestrutura apenas. Nenhuma credencial de Meta/GA4/Guru vai
# aqui: elas são cadastradas pelo painel (tabelas settings/ga4_accounts/
# meta_pixels/meta_ad_accounts), guardadas no Supabase Vault. Ver CLAUDE.md.

NEXT_PUBLIC_SUPABASE_URL=

# Chaves novas do Supabase (recomendado). Se o projeto ainda não migrou,
# use as legadas: NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Domínios/padrões permitidos a chamar /api/identify e /api/event (CORS),
# separados por vírgula. "*.dominio.com" casa o domínio raiz + qualquer
# subdomínio (ex: www.rcsalariomaternidade.com.br). Sem essa var, usa o
# fallback em lib/cors.ts (*.rcsalariomaternidade.com.br).
# TRACKING_ALLOWED_ORIGINS=*.rcsalariomaternidade.com.br
